@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PCL 1.11 COMPONENTS common filters)
include("${CMAKE_CURRENT_LIST_DIR}/WeldSeamTargets.cmake")
# PCL 1.11 does not propagate every third-party header through its targets.
set_property(TARGET WeldSeam::WeldSeam APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${PCL_INCLUDE_DIRS}")
check_required_components(WeldSeam)
